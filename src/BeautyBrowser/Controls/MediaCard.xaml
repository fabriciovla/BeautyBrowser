<UserControl
    x:Class="BeautyBrowser.Controls.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BeautyBrowser">

    <!--
        What is playing, at the bottom of the sidebar. Compact: artwork, title, artist and moving bars. On hover it
        expands with progress, times and controls (go to tab, previous, play/pause, next, mute).
    -->
    <Border
        x:Name="Card"
        Padding="10"
        Background="{StaticResource BeautyMediaCardBrush}"
        BorderBrush="{StaticResource BeautyInsetBorderBrush}"
        BorderThickness="1"
        CornerRadius="12"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        Tapped="Card_Tapped">
        <StackPanel>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="40"
                    Height="40"
                    Background="{StaticResource BeautySubtleFillBrush}"
                    CornerRadius="8">
                    <Grid>
                        <Image x:Name="FallbackIcon" Width="20" Height="20" />
                        <Image x:Name="Artwork" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BeautyTextBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ArtistText"
                        FontSize="11.5"
                        Foreground="{StaticResource BeautyTextSecondaryBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel
                        x:Name="Bars"
                        Height="16"
                        Margin="0,0,4,0"
                        Orientation="Horizontal"
                        Spacing="2.5" />
                    <Button
                        x:Name="CloseButton"
                        Click="Close_Click"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Style="{StaticResource BeautyTabCloseButton}"
                        ToolTipService.ToolTip="{local:T En='Close', Es='Cerrar'}">
                        <FontIcon FontSize="8" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Grid>

            <StackPanel x:Name="Details" Height="0" Opacity="0">
                <Grid
                    x:Name="Track"
                    Height="14"
                    Margin="0,12,0,0"
                    Background="Transparent"
                    PointerPressed="Track_PointerPressed">
                    <Border
                        Height="3"
                        VerticalAlignment="Center"
                        Background="{StaticResource BeautyDividerBrush}"
                        CornerRadius="1.5" />
                    <Border
                        x:Name="TrackFill"
                        Width="0"
                        Height="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{StaticResource BeautyTextBrush}"
                        CornerRadius="1.5" />
                </Grid>
                <Grid Margin="0,1,0,0">
                    <TextBlock
                        x:Name="ElapsedText"
                        FontSize="10.5"
                        Foreground="{StaticResource BeautyTextSecondaryBrush}" />
                    <TextBlock
                        x:Name="RemainingText"
                        HorizontalAlignment="Right"
                        FontSize="10.5"
                        Foreground="{StaticResource BeautyTextSecondaryBrush}" />
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Center"
                        Click="Open_Click"
                        Style="{StaticResource BeautyIconButton}"
                        ToolTipService.ToolTip="{local:T En='Go to tab', Es='Ir a la pestaña'}">
                        <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                    </Button>
                    <Button
                        x:Name="PreviousButton"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        Click="Previous_Click"
                        Style="{StaticResource BeautyIconButton}"
                        ToolTipService.ToolTip="{local:T En='Previous', Es='Anterior'}">
                        <FontIcon FontSize="14" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource BeautySubtleFillBrush}"
                        Click="PlayPause_Click"
                        CornerRadius="18"
                        Style="{StaticResource BeautyIconButton}">
                        <FontIcon x:Name="PlayIcon" FontSize="15" Glyph="&#xE769;" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        Click="Next_Click"
                        Style="{StaticResource BeautyIconButton}"
                        ToolTipService.ToolTip="{local:T En='Next', Es='Siguiente'}">
                        <FontIcon FontSize="14" Glyph="&#xE893;" />
                    </Button>
                    <Button
                        x:Name="MuteButton"
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        Click="Mute_Click"
                        Style="{StaticResource BeautyIconButton}">
                        <FontIcon x:Name="MuteIcon" FontSize="14" Glyph="&#xE767;" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
