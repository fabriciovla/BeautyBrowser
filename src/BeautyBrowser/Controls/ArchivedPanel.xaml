<UserControl
    x:Class="BeautyBrowser.Controls.ArchivedPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BeautyBrowser">

    <!-- Archived tabs: search above, the list (newest first) below. The rows are built in code. -->
    <Grid RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="8,8,8,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                Height="36"
                Padding="12,0,4,0"
                Background="{StaticResource BeautySubtleFillBrush}"
                ColumnSpacing="8"
                CornerRadius="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="13"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    Glyph="&#xE721;" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Padding="0,7"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ArchivedSearch"
                    FontSize="13"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{local:T En='Search archived tabs', Es='Buscar en pestañas archivadas'}"
                    TextChanged="SearchBox_TextChanged" />
            </Grid>
            <Button
                x:Name="ClearButton"
                Grid.Column="1"
                Height="36"
                Padding="12,0"
                Background="{StaticResource BeautySubtleFillBrush}"
                CornerRadius="10"
                Style="{StaticResource BeautyIconButton}"
                UseSystemFocusVisuals="False"
                ToolTipService.ToolTip="{local:T En='Remove all archived tabs', Es='Quitar todas las pestañas archivadas'}">
                <FontIcon FontSize="13" Glyph="&#xE74D;" />
                <Button.Flyout>
                    <Flyout x:Name="ClearFlyout">
                        <StackPanel Width="220" Spacing="10">
                            <TextBlock FontSize="13" Text="{local:T En='Remove every archived tab?', Es='¿Quitar todas las pestañas archivadas?'}" TextWrapping="Wrap" />
                            <Button Click="Clear_Click" Content="{local:T En='Remove all', Es='Quitar todas'}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <ScrollView
            x:Name="Scroller"
            Grid.Row="1"
            ContentOrientation="Vertical"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,4,6,12">
                <StackPanel x:Name="Rows" />
                <TextBlock
                    x:Name="EmptyText"
                    Margin="14,24,14,0"
                    FontSize="13"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollView>
    </Grid>
</UserControl>
