<UserControl
    x:Class="BeautyBrowser.Controls.SiteSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BeautyBrowser">

    <!-- Site settings (zoom and the ad blocker for this site): the content of the flyout in the sidebar and in the top bar. -->
    <StackPanel Width="220" Spacing="10">
        <!-- What the blocker stopped on this page. -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock
                x:Name="BlockedNumber"
                VerticalAlignment="Center"
                FontSize="30"
                FontWeight="SemiBold"
                Text="0" />
            <TextBlock
                x:Name="BlockedLabel"
                MaxWidth="130"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource BeautyTextSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <Rectangle Height="1" Fill="{StaticResource BeautyDividerBrush}" />
        <TextBlock FontWeight="SemiBold" Text="Zoom" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="ZoomOut_Click" Style="{StaticResource BeautyIconButton}">
                <FontIcon FontSize="14" Glyph="&#xE738;" />
            </Button>
            <TextBlock
                x:Name="ZoomText"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <Button Grid.Column="2" Click="ZoomIn_Click" Style="{StaticResource BeautyIconButton}">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
        </Grid>
        <HyperlinkButton Padding="0" Click="ZoomReset_Click" Content="{local:T En='Reset', Es='Restablecer'}" />
        <Rectangle Height="1" Fill="{StaticResource BeautyDividerBrush}" />
        <Button
            x:Name="SiteBlockerRow"
            MinHeight="44"
            Margin="-8,0"
            Padding="8,6"
            Click="SiteBlocker_Click"
            Style="{StaticResource BeautyListRowButton}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="SiteBlockerIcon" FontSize="15" Glyph="&#xEA18;" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock FontSize="13" Text="{local:T En='Ad blocker', Es='Bloqueador de anuncios'}" />
                    <TextBlock
                        x:Name="SiteBlockerHint"
                        FontSize="11"
                        Foreground="{StaticResource BeautyTextSecondaryBrush}" />
                </StackPanel>
                <TextBlock
                    x:Name="SiteBlockerState"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold" />
            </Grid>
        </Button>
        <!-- The site as an app of its own (its window and taskbar icon); a site already installed opens there. -->
        <Button
            x:Name="InstallAppRow"
            MinHeight="40"
            Margin="-8,0"
            Padding="8,6"
            Click="InstallApp_Click"
            Style="{StaticResource BeautyListRowButton}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon FontSize="15" Glyph="&#xE71D;" />
                <TextBlock x:Name="InstallAppText" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
