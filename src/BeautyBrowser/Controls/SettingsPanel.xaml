<UserControl
    x:Class="BeautyBrowser.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:BeautyBrowser"
    xmlns:local="using:BeautyBrowser.Controls">

    <!--
        Settings inside the library, built from custom rows (options with a check mark, chips and switches). The dynamic
        rows are built in SettingsPanel.xaml.cs. ScrollView rather than ScrollViewer: wheel scrolling is animated on
        the GPU, as smooth as in pages.
    -->
    <ScrollView
        ContentOrientation="Vertical"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="6,0,6,18">

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='On startup', Es='Al iniciar'}" />
            <Border Padding="2" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel x:Name="StartupRows" />
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Search engine', Es='Buscador'}" />
            <Border Padding="2" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel x:Name="EngineRows" />
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Home page and new tabs', Es='Página de inicio y pestañas nuevas'}" />
            <Grid
                Height="38"
                Padding="12,0,8,0"
                Background="{StaticResource BeautySubtleFillBrush}"
                ColumnSpacing="10"
                CornerRadius="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="13"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    Glyph="&#xE80F;" />
                <TextBox
                    x:Name="HomePageText"
                    Grid.Column="1"
                    Padding="0,8"
                    VerticalAlignment="Center"
                    FontSize="13"
                    IsSpellCheckEnabled="False"
                    KeyDown="HomePageText_KeyDown"
                    LostFocus="HomePageText_LostFocus"
                    PlaceholderText="https://www.google.com" />
            </Grid>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Appearance', Es='Apariencia'}" />
            <Border Padding="12,10,12,12" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="13" Text="{app:T En='Color', Es='Color'}" />
                    <StackPanel x:Name="ThemeRow" Margin="-4,0,0,6" Orientation="Horizontal" Spacing="2" />
                    <TextBlock FontSize="13" Text="{app:T En='Page zoom', Es='Zoom de las páginas'}" />
                    <Grid x:Name="ZoomChips" ColumnSpacing="4" />
                    <TextBlock Margin="0,6,0,0" FontSize="13" Text="{app:T En='Font size', Es='Tamaño de letra'}" />
                    <Grid x:Name="FontChips" ColumnSpacing="4" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource BeautyTextSecondaryBrush}"
                        Text="{app:T En='Applies right away to every tab.', Es='Se aplica en el momento a todas las pestañas.'}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Glass texture', Es='Textura del vidrio'}" />
            <Border Padding="12,8,12,12" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{app:T En='Texture', Es='Textura'}" />
                        <Button
                            x:Name="TextureButton"
                            Height="30"
                            Padding="10,0,8,0"
                            HorizontalAlignment="Right"
                            Background="{StaticResource BeautyCardBrush}"
                            Style="{StaticResource BeautyIconButton}"
                            UseSystemFocusVisuals="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="TextureName" VerticalAlignment="Center" FontSize="12" />
                                <FontIcon VerticalAlignment="Center" FontSize="9" Glyph="&#xE70D;" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="TextureFlyout" Placement="BottomEdgeAlignedRight">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Background" Value="#F7FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#14000000" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel x:Name="TextureRows" Width="150" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <TextBlock FontSize="13" Text="{app:T En='Grain', Es='Grano'}" />
                        <TextBlock
                            x:Name="GrainText"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource BeautyTextSecondaryBrush}" />
                    </Grid>
                    <!-- Live sample: the same glass with the selected texture. -->
                    <Border
                        Height="56"
                        Background="#ECEEF3"
                        BorderBrush="{StaticResource BeautyInsetBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <local:NoiseLayer />
                    </Border>
                    <local:BeautySlider x:Name="GrainSlider" />

                    <Grid Margin="0,2,0,0">
                        <TextBlock FontSize="13" Text="{app:T En='Softness', Es='Suavidad'}" />
                        <TextBlock
                            x:Name="SoftnessText"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource BeautyTextSecondaryBrush}" />
                    </Grid>
                    <local:BeautySlider x:Name="SoftnessSlider" />

                    <Button
                        Height="28"
                        Padding="12,0"
                        HorizontalAlignment="Right"
                        Background="{StaticResource BeautySubtleFillBrush}"
                        Click="ResetGlass_Click"
                        Style="{StaticResource BeautyIconButton}"
                        UseSystemFocusVisuals="False">
                        <TextBlock FontSize="12" Text="{app:T En='Reset', Es='Restablecer'}" />
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Sidebar and tabs', Es='Barra lateral y pestañas'}" />
            <Border Padding="2" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel>
                    <StackPanel x:Name="SidebarToggles" />
                    <Rectangle Height="1" Margin="12,0,10,0" Fill="{StaticResource BeautyDividerBrush}" />
                    <StackPanel Padding="12,10,12,10" Spacing="8">
                        <StackPanel Spacing="1">
                            <TextBlock FontSize="13" Text="{app:T En='Hide the sidebar automatically', Es='Esconder la barra sola'}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource BeautyTextSecondaryBrush}"
                                Text="{app:T En='When the mouse rests and it is not pinned', Es='Con el mouse quieto, cuando no está fija'}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid x:Name="IdleChips" ColumnSpacing="4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Downloads', Es='Descargas'}" />
            <Border Padding="2" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel>
                    <Button
                        MinHeight="50"
                        Padding="12,7,10,7"
                        Click="ChangeFolder_Click"
                        Style="{StaticResource BeautyListRowButton}"
                        ToolTipService.ToolTip="{app:T En='Choose another folder', Es='Elegir otra carpeta'}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="13" Text="{app:T En='Save to', Es='Guardar en'}" />
                                <TextBlock
                                    x:Name="FolderText"
                                    FontSize="11"
                                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource BeautyAccentBrush}"
                                Text="{app:T En='Change', Es='Cambiar'}" />
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Margin="40,0,10,0" Fill="{StaticResource BeautyDividerBrush}" />
                    <StackPanel x:Name="DownloadToggles" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Privacy and security', Es='Privacidad y seguridad'}" />
            <Border Padding="2" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel>
                    <StackPanel x:Name="PrivacyToggles" />
                    <Rectangle Height="1" Margin="40,0,10,0" Fill="{StaticResource BeautyDividerBrush}" />
                    <Button
                        x:Name="ClearHistoryRow"
                        MinHeight="50"
                        Padding="12,7,10,7"
                        Click="ClearHistory_Click"
                        Style="{StaticResource BeautyListRowButton}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="15" Glyph="&#xE81C;" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="13" Text="{app:T En='Clear history', Es='Borrar historial'}" />
                                <TextBlock
                                    x:Name="ClearHistoryHint"
                                    FontSize="11"
                                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                                    Text="{app:T En='The pages you visited on this PC', Es='Las páginas que visitaste en esta PC'}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Rectangle Height="1" Margin="40,0,10,0" Fill="{StaticResource BeautyDividerBrush}" />
                    <Button
                        x:Name="ClearCookiesRow"
                        MinHeight="50"
                        Padding="12,7,10,7"
                        Click="ClearCookies_Click"
                        Style="{StaticResource BeautyListRowButton}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="15" Glyph="&#xE72E;" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontSize="13" Text="{app:T En='Clear cookies and sessions', Es='Borrar cookies y sesiones'}" />
                                <TextBlock
                                    x:Name="ClearCookiesHint"
                                    FontSize="11"
                                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                                    Text="{app:T En='You will have to sign in to sites again', Es='Vas a tener que volver a iniciar sesión en los sitios'}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='Preferred page language', Es='Idioma preferido de las páginas'}" />
            <Border Padding="2" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel x:Name="LanguageRows" />
            </Border>

            <TextBlock Style="{StaticResource BeautySectionLabel}" Text="{app:T En='System', Es='Sistema'}" />
            <Border Padding="2" Background="{StaticResource BeautySubtleFillBrush}" CornerRadius="10">
                <StackPanel>
                    <StackPanel x:Name="SystemToggles" />
                    <!-- Only shown after changing hardware acceleration, which applies on restart. -->
                    <Button
                        x:Name="RestartRow"
                        MinHeight="44"
                        Padding="12,6,12,6"
                        Click="Restart_Click"
                        Style="{StaticResource BeautyListRowButton}"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource BeautyTextSecondaryBrush}"
                                Text="{app:T En='Applies on restart. Your tabs come back.', Es='Se aplica al reiniciar. Tus pestañas vuelven.'}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BeautyAccentBrush}"
                                Text="{app:T En='Restart now', Es='Reiniciar ahora'}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Button
                x:Name="ResetRow"
                MinHeight="50"
                Margin="0,14,0,0"
                Padding="12,7,10,7"
                Click="Reset_Click"
                Style="{StaticResource BeautyListRowButton}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="15" Glyph="&#xE777;" />
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock FontSize="13" Text="{app:T En='Reset settings', Es='Restablecer configuración'}" />
                        <TextBlock
                            x:Name="ResetHint"
                            FontSize="11"
                            Foreground="{StaticResource BeautyTextSecondaryBrush}"
                            Text="{app:T En='Restores the defaults. History and favorites stay.', Es='Vuelve todo a como venía. No borra historial ni favoritos.'}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>

            <TextBlock
                x:Name="VersionText"
                Margin="10,18,10,0"
                FontSize="11"
                Foreground="{StaticResource BeautyTextSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollView>
</UserControl>
