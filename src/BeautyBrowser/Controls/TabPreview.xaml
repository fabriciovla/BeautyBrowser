<UserControl
    x:Class="BeautyBrowser.Controls.TabPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BeautyBrowser">

    <!--
        Tab preview shown when hovering a tab in the sidebar: the page as it last looked, title, site and quick
        actions. It floats next to the sidebar, over the page.
    -->
    <Border
        x:Name="Card"
        Width="300"
        Background="{StaticResource BeautyCardBrush}"
        BorderBrush="{StaticResource BeautyPanelBorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <StackPanel>
            <Grid Height="168" Background="#F3F3F6" CornerRadius="13,13,0,0">
                <Image
                    x:Name="EmptyIcon"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <!-- A brush, not an Image: a Border clips its background to the rounded corners. -->
                <Border CornerRadius="13,13,0,0">
                    <Border.Background>
                        <ImageBrush
                            x:Name="Thumbnail"
                            AlignmentY="Top"
                            Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource BeautyDividerBrush}" />
            </Grid>

            <StackPanel Padding="18,14,18,4" Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BeautyTextBrush}"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SiteText"
                    FontSize="13"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Padding="8,4,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PinButton"
                    HorizontalAlignment="Center"
                    Click="Pin_Click"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    Style="{StaticResource BeautyIconButton}">
                    <FontIcon x:Name="PinIcon" FontSize="15" Glyph="&#xE718;" />
                </Button>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Click="CopyLink_Click"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Copy link', Es='Copiar enlace'}">
                    <FontIcon x:Name="CopyIcon" FontSize="15" Glyph="&#xE71B;" />
                </Button>
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    Click="Duplicate_Click"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Duplicate tab', Es='Duplicar pestaña'}">
                    <FontIcon FontSize="15" Glyph="&#xE8C8;" />
                </Button>
                <Button
                    x:Name="MuteButton"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    Click="Mute_Click"
                    Foreground="{StaticResource BeautyTextSecondaryBrush}"
                    Style="{StaticResource BeautyIconButton}">
                    <FontIcon x:Name="MuteIcon" FontSize="15" Glyph="&#xE767;" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
