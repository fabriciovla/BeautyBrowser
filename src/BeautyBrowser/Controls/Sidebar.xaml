<UserControl
    x:Class="BeautyBrowser.Controls.Sidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BeautyBrowser.Controls"
    xmlns:kit="using:BeautyKit"
    xmlns:local="using:BeautyBrowser"
    xmlns:services="using:BeautyBrowser.Services">

    <!-- Glass panel, floating or pinned. -->
    <Grid
        x:Name="Panel"
        Padding="10,10,8,8"
        Background="{StaticResource BeautyPanelBrush}"
        BorderBrush="{StaticResource BeautyPanelBorderBrush}"
        BorderThickness="0,0,1,0"
        CornerRadius="{StaticResource BeautyPanelCornerRadius}"
        RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0 library and navigation -->
            <RowDefinition Height="Auto" />  <!-- 1 address -->
            <RowDefinition Height="Auto" />  <!-- 2 favorites -->
            <RowDefinition Height="Auto" />  <!-- 3 space name -->
            <RowDefinition Height="Auto" />  <!-- 4 divider and clear -->
            <RowDefinition Height="Auto" />  <!-- 5 new tab -->
            <RowDefinition Height="*" />     <!-- 6 tabs -->
            <RowDefinition Height="Auto" />  <!-- 7 now playing -->
            <RowDefinition Height="Auto" />  <!-- 8 downloads and spaces -->
        </Grid.RowDefinitions>

        <!-- Glass grain (Settings → Appearance), under the content -->
        <controls:NoiseLayer Grid.RowSpan="9" Margin="-10,-10,-8,-8" />

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="MenuButton"
                    Click="Library_Click"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='History, downloads and settings (Ctrl+H)', Es='Historial, descargas y ajustes (Ctrl+H)'}">
                    <FontIcon FontSize="14" Glyph="&#xE8F1;" />
                </Button>
                <Button
                    x:Name="DockButton"
                    Click="Dock_Click"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Pin sidebar (Ctrl+S)', Es='Fijar barra lateral (Ctrl+S)'}">
                    <FontIcon x:Name="DockIcon" FontSize="14" Glyph="&#xE90C;" />
                </Button>
            </StackPanel>


            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource BeautyIconButton}" ToolTipService.ToolTip="{local:T En='Back', Es='Atrás'}">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button x:Name="ForwardButton" Click="Forward_Click" Style="{StaticResource BeautyIconButton}" ToolTipService.ToolTip="{local:T En='Forward', Es='Adelante'}">
                    <FontIcon FontSize="14" Glyph="&#xE72A;" />
                </Button>
                <Button Click="Reload_Click" Style="{StaticResource BeautyIconButton}" ToolTipService.ToolTip="{local:T En='Reload', Es='Volver a cargar'}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="UrlBarContainer"
            Grid.Row="1"
            Height="38"
            Background="{StaticResource BeautySubtleFillBrush}"
            CornerRadius="{StaticResource BeautyItemCornerRadius}"
            PointerEntered="UrlBar_PointerEntered"
            PointerExited="UrlBar_PointerExited">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="UrlButton"
                Height="38"
                Padding="12,0"
                Click="Url_Click"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{StaticResource BeautyItemCornerRadius}"
                Foreground="{StaticResource BeautyTextBrush}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                ToolTipService.ToolTip="{local:T En='Search or type a URL (Ctrl+L)', Es='Buscar o escribir una URL (Ctrl+L)'}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                </Button.Resources>
                <TextBlock x:Name="UrlText" TextTrimming="CharacterEllipsis" />
            </Button>
            <StackPanel Grid.Column="1" Margin="0,0,4,0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- The page's zoom while it is not the default one, as in Chrome; a click restores it. -->
                <Button
                    x:Name="ZoomBadge"
                    Height="24"
                    Padding="6,0"
                    Click="ZoomReset_Click"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Reset zoom', Es='Restablecer zoom'}"
                    Visibility="Collapsed">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#10000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1C000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#26000000" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="11" Glyph="&#xE71E;" />
                        <TextBlock x:Name="ZoomBadgeText" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Click="CopyLink_Click"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Copy link', Es='Copiar enlace'}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#20000000" />
                    </Button.Resources>
                    <FontIcon x:Name="CopyLinkIcon" FontSize="13" Glyph="&#xE71B;" />
                </Button>
                <Button
                    x:Name="SiteSettingsButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Site settings', Es='Ajustes del sitio'}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#20000000" />
                    </Button.Resources>
                    <FontIcon FontSize="13" Glyph="&#xE9E9;" />
                    <Button.Flyout>
                        <Flyout x:Name="SiteFlyout" Opening="SiteFlyout_Opening" Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="220" Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="Zoom" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="ZoomOut_Click" Style="{StaticResource BeautyIconButton}">
                                        <FontIcon FontSize="14" Glyph="&#xE738;" />
                                    </Button>
                                    <TextBlock
                                        x:Name="ZoomText"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Click="ZoomIn_Click" Style="{StaticResource BeautyIconButton}">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    </Button>
                                </Grid>
                                <HyperlinkButton Padding="0" Click="ZoomReset_Click" Content="{local:T En='Reset', Es='Restablecer'}" />
                                <Rectangle Height="1" Fill="{StaticResource BeautyDividerBrush}" />
                                <Button
                                    x:Name="SiteBlockerRow"
                                    MinHeight="44"
                                    Margin="-8,0"
                                    Padding="8,6"
                                    Click="SiteBlocker_Click"
                                    Style="{StaticResource BeautyListRowButton}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="SiteBlockerIcon" FontSize="15" Glyph="&#xEA18;" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock FontSize="13" Text="{local:T En='Ad blocker', Es='Bloqueador de anuncios'}" />
                                            <TextBlock
                                                x:Name="SiteBlockerHint"
                                                FontSize="11"
                                                Foreground="{StaticResource BeautyTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="SiteBlockerState"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Favorites: icon tiles, three per row (built in Sidebar.xaml.cs). -->
        <Grid
            x:Name="FavoritesGrid"
            Grid.Row="2"
            Margin="0,4,0,2"
            ColumnSpacing="8"
            RowSpacing="8" />
        <!-- The favorite being dragged floats here, leaving its gap in the grid. -->
        <Canvas
            x:Name="FavoritesDragLayer"
            Grid.Row="2"
            Margin="0,4,0,2"
            IsHitTestVisible="False" />

        <StackPanel
            Grid.Row="3"
            Margin="8,4,0,0"
            Orientation="Horizontal"
            Spacing="8">
            <FontIcon
                x:Name="SpaceIcon"
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="{StaticResource BeautyTextSecondaryBrush}" />
            <TextBlock
                x:Name="SpaceName"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource BeautyTextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="4,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{StaticResource BeautyDividerBrush}" />
            <HyperlinkButton
                Grid.Column="1"
                Padding="4,0"
                Click="Clear_Click"
                Foreground="{StaticResource BeautyTextSecondaryBrush}"
                ToolTipService.ToolTip="{local:T En='Close the other tabs in this space', Es='Cerrar las demás pestañas de este space'}">
                <TextBlock FontSize="11" Text="{local:T En='Clear', Es='Limpiar'}" />
            </HyperlinkButton>
        </Grid>

        <Button
            Grid.Row="5"
            Click="NewTab_Click"
            Style="{StaticResource BeautyRowButton}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon FontSize="13" Glyph="&#xE710;" />
                <TextBlock Text="{local:T En='New tab', Es='Nueva pestaña'}" />
            </StackPanel>
        </Button>

        <!-- Behind the list: the active tab's card, which slides (Sidebar.TabIndicator.cs). -->
        <Grid
            x:Name="TabIndicatorHost"
            Grid.Row="6"
            Margin="-4,0"
            IsHitTestVisible="False">
            <Grid x:Name="TabIndicator" Margin="4,0" VerticalAlignment="Top">
                <!-- The shadow: a slightly darker edge peeking 1px below. -->
                <Border
                    Margin="0,0,0,-1"
                    Background="#0D000000"
                    CornerRadius="{StaticResource BeautyItemCornerRadius}" />
                <Border
                    Background="{StaticResource BeautyCardBrush}"
                    BorderBrush="#0F000000"
                    BorderThickness="1"
                    CornerRadius="{StaticResource BeautyItemCornerRadius}" />
            </Grid>
        </Grid>
        <ListView
            x:Name="TabList"
            Grid.Row="6"
            Margin="-4,0"
            Padding="0,4"
            Background="Transparent"
            ContainerContentChanging="TabList_ContainerContentChanging"
            ItemContainerStyle="{StaticResource BeautyTabItemStyle}"
            Loaded="TabList_Loaded"
            SelectionChanged="TabList_SelectionChanged"
            SelectionMode="Single">
            <!-- No theme animations: Sidebar.TabMotion.cs moves the rows in step with the active tab's card. -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.Resources>
                <ResourceDictionary Source="ms-appx:///Theme/BeautyLists.xaml" />
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="kit:BrowserTab">
                    <Grid
                        Height="42"
                        Background="Transparent"
                        ColumnSpacing="10"
                        PointerEntered="TabItem_PointerEntered"
                        PointerExited="TabItem_PointerExited"
                        PointerPressed="TabItem_PointerPressed"
                        PointerReleased="TabItem_PointerReleased"
                        RightTapped="TabItem_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="14"
                            Foreground="{StaticResource BeautyTextSecondaryBrush}"
                            Glyph="&#xE774;"
                            Visibility="{x:Bind local:BindHelpers.VisibleIfNull(Favicon), Mode=OneWay}" />
                        <Image Width="16" Height="16" Source="{x:Bind Favicon, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource BeautyTextBrush}"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="CloseTab_Click"
                            Opacity="0"
                            Style="{StaticResource BeautyTabCloseButton}"
                            ToolTipService.ToolTip="{local:T En='Close tab (Ctrl+W)', Es='Cerrar pestaña (Ctrl+W)'}">
                            <FontIcon FontSize="8" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Now playing: shows up by itself when a tab plays music or video. -->
        <controls:MediaCard x:Name="NowPlaying" Grid.Row="7" Margin="0,4,0,2" />

        <Grid Grid.Row="8" Height="40">
            <Button
                x:Name="LibraryButton"
                HorizontalAlignment="Left"
                Click="Downloads_Click"
                RenderTransformOrigin="0.5,0.5"
                Style="{StaticResource BeautyIconButton}"
                ToolTipService.ToolTip="{local:T En='Downloads (Ctrl+J)', Es='Descargas (Ctrl+J)'}">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="LibraryScale" />
                </Button.RenderTransform>
                <FontIcon x:Name="LibraryIcon" FontSize="16" Glyph="&#xE896;" />
            </Button>

            <StackPanel
                x:Name="SpaceDots"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4" />

            <Button
                HorizontalAlignment="Right"
                Click="AddSpace_Click"
                Style="{StaticResource BeautyIconButton}"
                ToolTipService.ToolTip="{local:T En='New space', Es='Nuevo space'}">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
