<UserControl
    x:Class="BeautyBrowser.Controls.TopBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BeautyBrowser">

    <!--
        Tabs on top, as in Chrome: a strip of tabs (the caption buttons sit at its right end) and below it the toolbar
        with navigation, the address and the library. A solid bar, no glass, as in Chrome; the page
        fills the rest of the window.
    -->
    <Grid
        x:Name="Panel"
        Background="{StaticResource BeautyTopBarBrush}"
        BorderBrush="{StaticResource BeautyDividerBrush}"
        BorderThickness="0,0,0,1">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />  <!-- tabs -->
            <RowDefinition Height="46" />  <!-- toolbar -->
        </Grid.RowDefinitions>

        <Grid x:Name="Strip" Padding="8,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- favorites -->
                <ColumnDefinition Width="Auto" />  <!-- tabs -->
                <ColumnDefinition Width="Auto" />  <!-- new tab -->
                <ColumnDefinition Width="*" />     <!-- free: drags the window -->
                <ColumnDefinition Width="140" />   <!-- minimize, maximize, close -->
            </Grid.ColumnDefinitions>
            <!-- Favorites: the mouse over the star opens them in a panel below. -->
            <Button
                x:Name="FavoritesButton"
                Width="34"
                Height="32"
                Margin="0,0,6,0"
                Padding="0"
                VerticalAlignment="Center"
                Click="Favorites_Click"
                PointerEntered="Favorites_PointerEntered"
                PointerExited="Favorites_PointerExited"
                Style="{StaticResource BeautyIconButton}"
                AutomationProperties.AutomationId="TopFavorites"
                AutomationProperties.Name="{local:T En='Favorites', Es='Favoritos'}">
                <FontIcon FontSize="15" Glyph="&#xE734;" />
            </Button>
            <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" Spacing="2" />
            <Button
                x:Name="NewTabButton"
                Grid.Column="2"
                Width="30"
                Height="30"
                Margin="4,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                Click="NewTab_Click"
                Style="{StaticResource BeautyIconButton}"
                ToolTipService.ToolTip="{local:T En='New tab (Ctrl+T)', Es='Nueva pestaña (Ctrl+T)'}"
                AutomationProperties.Name="{local:T En='New tab', Es='Nueva pestaña'}">
                <FontIcon FontSize="13" Glyph="&#xE710;" />
            </Button>
            <Border x:Name="DragZone" Grid.Column="3" Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1" Padding="8,4,8,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    Click="Library_Click"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='History, downloads and settings (Ctrl+H)', Es='Historial, descargas y ajustes (Ctrl+H)'}">
                    <FontIcon FontSize="14" Glyph="&#xE8F1;" />
                </Button>
                <Button
                    x:Name="SpaceButton"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Spaces', Es='Spaces'}">
                    <FontIcon x:Name="SpaceIcon" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SpaceMenu" Opening="SpaceMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource BeautyIconButton}" ToolTipService.ToolTip="{local:T En='Back', Es='Atrás'}">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button x:Name="ForwardButton" Click="Forward_Click" Style="{StaticResource BeautyIconButton}" ToolTipService.ToolTip="{local:T En='Forward', Es='Adelante'}">
                    <FontIcon FontSize="14" Glyph="&#xE72A;" />
                </Button>
                <Button Click="Reload_Click" Style="{StaticResource BeautyIconButton}" ToolTipService.ToolTip="{local:T En='Reload', Es='Volver a cargar'}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>

            <!-- The address bar is a real box: click and type, the suggestions drop below it (CommandPalette.OpenAttached). -->
            <Grid
                x:Name="AddressBar"
                Grid.Column="1"
                Height="34"
                Margin="6,0"
                Padding="14,0,6,0"
                Background="{StaticResource BeautyCardBrush}"
                BorderBrush="{StaticResource BeautyTileBorderBrush}"
                BorderThickness="1"
                ColumnSpacing="8"
                CornerRadius="17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <FontIcon
                        x:Name="UrlInsecureIcon"
                        FontSize="13"
                        Foreground="#E0A030"
                        Glyph="&#xE7BA;"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="UrlSecureIcon"
                        FontSize="12"
                        Foreground="{StaticResource BeautyTextSecondaryBrush}"
                        Glyph="&#xE72E;"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="UrlSearchIcon"
                        FontSize="13"
                        Foreground="{StaticResource BeautyTextSecondaryBrush}"
                        Glyph="&#xE721;"
                        Visibility="Collapsed" />
                </Grid>
                <TextBox
                    x:Name="AddressBox"
                    Grid.Column="1"
                    Padding="0,6"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    IsSpellCheckEnabled="False"
                    AutomationProperties.Name="{local:T En='Address and search', Es='Dirección y búsqueda'}"
                    GotFocus="AddressBox_GotFocus"
                    LostFocus="AddressBox_LostFocus"
                    PlaceholderText="{local:T En='Search or type a URL', Es='Buscar o escribir una URL'}">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="DownloadsButton"
                    Click="Downloads_Click"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Downloads (Ctrl+J)', Es='Descargas (Ctrl+J)'}">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="DownloadsScale" />
                    </Button.RenderTransform>
                    <FontIcon x:Name="DownloadsIcon" FontSize="15" Glyph="&#xE896;" />
                </Button>
                <Button
                    Click="Settings_Click"
                    Style="{StaticResource BeautyIconButton}"
                    ToolTipService.ToolTip="{local:T En='Settings (Ctrl+,)', Es='Ajustes (Ctrl+,)'}">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
