<UserControl
    x:Class="BeautyBrowser.Controls.TabSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tab switcher (Ctrl+Tab): while Ctrl is held every Tab moves the frame to the next tab, and releasing Ctrl
        goes to the selected one. Esc cancels.
    -->
    <Grid x:Name="Scrim" Background="#24000000" Tapped="Scrim_Tapped">
        <Grid
            x:Name="Card"
            Padding="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource BeautyPanelBrush}"
            BorderBrush="{StaticResource BeautyPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Tapped="Card_Tapped">
            <ScrollViewer
                x:Name="Scroller"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid HorizontalAlignment="Left">
                    <Border
                        x:Name="Ring"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource BeautyCardBrush}"
                        BorderBrush="#33000000"
                        BorderThickness="1.5"
                        CornerRadius="13" />
                    <StackPanel x:Name="Cards" Orientation="Horizontal" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
