<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Lightweight resources for the sidebar tab list. The active tab's white card is not painted by the
        ListViewItem: it is a separate indicator that slides between tabs (Sidebar.TabIndicator.cs), so the
        selected background is transparent.
    -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0D000000" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14000000" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#08000000" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />

    <!-- The tab close button: a soft gray hover, since Windows' hover is invisible on the white card. -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#10000000" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1A000000" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1F1F24" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1F1F24" />
</ResourceDictionary>
