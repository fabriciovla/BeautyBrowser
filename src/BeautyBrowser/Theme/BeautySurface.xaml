<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Lightweight resources for the app's own surfaces (the library), so controls stop looking like stock Windows
        ones: buttons with a translucent gray hover and flat text boxes without a border or focus underline.
    -->

    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0C000000" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#16000000" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1F1F24" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1F1F24" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />

    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8A94" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A8A94" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A6A6AE" />
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
</ResourceDictionary>
