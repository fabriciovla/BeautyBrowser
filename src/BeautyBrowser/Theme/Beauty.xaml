<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Beauty design system: every color, radius, size and style of the app's own look. -->

    <x:Double x:Key="BeautyFrame">8</x:Double>                 <!-- glass frame around the page -->
    <x:Double x:Key="BeautySidebarWidthValue">264</x:Double>
    <GridLength x:Key="BeautySidebarWidth">264</GridLength>
    <CornerRadius x:Key="BeautyContentCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BeautyPanelCornerRadius">8</CornerRadius>  <!-- Windows 11 corners -->
    <CornerRadius x:Key="BeautyItemCornerRadius">8</CornerRadius>

    <Color x:Key="BeautyAccentColor">#2F6FEB</Color>
    <SolidColorBrush x:Key="BeautyAccentBrush" Color="{StaticResource BeautyAccentColor}" />
    <SolidColorBrush x:Key="BeautyTextBrush" Color="#1F1F24" />
    <SolidColorBrush x:Key="BeautyTextSecondaryBrush" Color="#8A8A94" />
    <SolidColorBrush x:Key="BeautySubtleFillBrush" Color="#0E000000" />
    <SolidColorBrush x:Key="BeautySubtleFillHoverBrush" Color="#18000000" />
    <!-- Favorite tiles: white glass that stands out from the background; the open one is a white card with a border. -->
    <SolidColorBrush x:Key="BeautyTileBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="BeautyTileHoverBrush" Color="#C7FFFFFF" />
    <SolidColorBrush x:Key="BeautyTileActiveBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BeautyTileBorderBrush" Color="#12000000" />
    <!-- Selected favorite: white card with a neutral gray border. -->
    <SolidColorBrush x:Key="BeautyTileActiveBorderBrush" Color="#3A2A2A33" />
    <SolidColorBrush x:Key="BeautyDividerBrush" Color="#14000000" />
    <SolidColorBrush x:Key="BeautyPanelBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="BeautyCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BeautyMediaCardBrush" Color="#C2FFFFFF" />
    <!-- Hover and pressed fills, and light surfaces; dark mode recolors them (see AppTheme). -->
    <SolidColorBrush x:Key="BeautyFillLowBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="BeautyFillHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="BeautyFillPressedBrush" Color="#20000000" />
    <SolidColorBrush x:Key="BeautyThumbBrush" Color="#F3F3F6" />
    <SolidColorBrush x:Key="BeautySurfaceBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="BeautySurfaceAltBrush" Color="#ECEEF3" />
    <!-- The settings tab's page, behind its white cards. -->
    <SolidColorBrush x:Key="BeautySettingsPageBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="BeautyTopBarBrush" Color="#ECECEF" />  <!-- tabs on top: solid, no glass -->
    <SolidColorBrush x:Key="BeautyPopupHoverBrush" Color="#F4F4F6" />
    <SolidColorBrush x:Key="BeautyPopupPressedBrush" Color="#EAEAEE" />

    <!-- Sidebar glass: light acrylic that shows the page blurred behind it. -->
    <AcrylicBrush
        x:Key="BeautyPanelBrush"
        FallbackColor="#F3F3F6"
        TintColor="#F4F4F7"
        TintLuminosityOpacity="0.92"
        TintOpacity="0.72" />

    <!--
        Every Beauty button. Its own template instead of Windows': hover is a soft fill over the button's own background
        that fades in, the text keeps its color, and there is no white plate, border or elevation. The fills come from
        the theme, so light and dark look alike.
    -->
    <Style x:Key="BeautyIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource BeautyTextBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BeautyItemCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Plate"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border
                            x:Name="Hover"
                            Background="{StaticResource BeautyFillHoverBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="Content"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.160" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource BeautyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Background" Value="{StaticResource BeautyFillPressedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{StaticResource BeautyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Plate.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar row ("New tab" and the like). -->
    <Style x:Key="BeautyRowButton" TargetType="Button" BasedOn="{StaticResource BeautyIconButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{StaticResource BeautyTextSecondaryBrush}" />
    </Style>

    <!-- Tab close button: a light X whose background only appears on hover; no border or Windows elevation. -->
    <Style x:Key="BeautyTabCloseButton" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BeautyTextSecondaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Plate" Background="Transparent" CornerRadius="11">
                        <Border x:Name="Hover" Background="{StaticResource BeautyFillHoverBrush}" CornerRadius="11" Opacity="0" />
                        <ContentPresenter
                            x:Name="Content"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.160" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource BeautyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Background" Value="{StaticResource BeautyFillPressedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{StaticResource BeautyTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Inner card that holds the library content: translucent white on the glass. -->
    <SolidColorBrush x:Key="BeautyInsetBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="BeautyInsetBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="BeautyDangerBrush" Color="#D6453D" />

    <!-- Small section label ("Today", "Search engine"…). -->
    <Style x:Key="BeautySectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BeautyTextSecondaryBrush}" />
        <Setter Property="Margin" Value="10,14,0,6" />
    </Style>

    <Style x:Key="BeautyListRowButton" TargetType="Button" BasedOn="{StaticResource BeautyIconButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <x:Double x:Key="BeautyLibraryRailWidthValue">112</x:Double>
    <x:Double x:Key="BeautyLibraryListWidthValue">320</x:Double>
    <SolidColorBrush x:Key="BeautyLibraryListBrush" Color="#3DFFFFFF" />  <!-- list column: slightly lighter glass -->

    <!-- Library rail button: large icon on top, name below. -->
    <Style x:Key="BeautyRailButton" TargetType="Button" BasedOn="{StaticResource BeautyIconButton}">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource BeautyItemCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="BeautyChipButton" TargetType="Button" BasedOn="{StaticResource BeautyIconButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- Sidebar tabs: the selected one is a white card, without the Windows selection bar. -->
    <Style x:Key="BeautyTabItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <!-- Room between the card (4px inset) and the favicon or X: 10px on the left, 8px on the right. -->
        <Setter Property="Padding" Value="14,0,12,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="CornerRadius" Value="{StaticResource BeautyItemCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--
            Custom template without Windows' selection indicator (the active tab is marked by our sliding card). With
            the indicator on, WinUI crashed (0xc0000005, SetSelectionIndicatorBackground) when a tab closed and the
            next one ended up under the mouse.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        x:Name="Root"
                        Control.IsTemplateFocusTarget="True"
                        Background="{TemplateBinding Background}"
                        CheckMode="Overlay"
                        ContentMargin="{TemplateBinding Padding}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                        DragBackground="{ThemeResource ListViewItemDragBackground}"
                        DragForeground="{ThemeResource ListViewItemDragForeground}"
                        DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                        FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                        FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                        FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                        PointerOverBackground="{ThemeResource ListViewItemBackgroundPointerOver}"
                        PressedBackground="{ThemeResource ListViewItemBackgroundPressed}"
                        ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                        SelectedBackground="{ThemeResource ListViewItemBackgroundSelected}"
                        SelectedPointerOverBackground="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"
                        SelectedPressedBackground="{ThemeResource ListViewItemBackgroundSelectedPressed}"
                        SelectionCheckMarkVisualEnabled="False"
                        SelectionIndicatorVisualEnabled="False"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
